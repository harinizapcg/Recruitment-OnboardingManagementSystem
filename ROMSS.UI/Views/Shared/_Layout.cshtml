<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>ROMSS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body>

    @if (Context.Session.GetString("JWT") != null)
    {
        <nav class="navbar navbar-expand-lg navbar-light navbar-glass sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-layers-fill text-primary" viewBox="0 0 16 16">
                        <path d="M7.765 1.559a.5.5 0 0 1 .47 0l7.5 4a.5.5 0 0 1 0 .882l-7.5 4a.5.5 0 0 1-.47 0l-7.5-4a.5.5 0 0 1 0-.882l7.5-4z"/>
                        <path d="m2.125 8.567-1.86.992a.5.5 0 0 0 0 .882l7.5 4a.5.5 0 0 0 .47 0l7.5-4a.5.5 0 0 0 0-.882l-1.86-.992-5.17 2.756a1.5 1.5 0 0 1-1.41 0l-5.17-2.756z"/>
                    </svg>
                    ROMSS
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/Candidate/Index">Candidates</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/Requisition/Index">Requisitions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/Job/Index">Jobs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/Users/Index">Users</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/Roles/Index">Roles</a>
                        </li>
                    </ul>
                    <a class="btn btn-outline-danger btn-sm px-4 fw-medium" href="/Auth/Logout" style="border-radius: 8px;">Logout</a>
                </div>
            </div>
        </nav>
    }

    <div class="container mt-4 mb-5">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>