@model ROMSS.UI.Models.DTO.UpdateRoleRequestDto
@{
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow p-4">
            <h3 class="mb-4">Edit Role</h3>
            <form method="post">
                <input asp-for="RoleId" type="hidden" />
                <div class="mb-3">
                    <label class="form-label">Role Name</label>
                    <input asp-for="RoleName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="RoleDescription" class="form-control" rows="3"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a href="/Roles/Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
            @if (ViewBag.Error != null)
            {
                <p class="text-danger mt-3">@ViewBag.Error</p>
            }
        </div>
    </div>
</div>