@model ROMSS.UI.Models.DTO.UpdateRequisitionRequestDto
@{
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white border-bottom py-4 px-4 px-md-5">
                    <h3 class="mb-0 fw-bold">Edit Requisition</h3>
                    <p class="mb-0 small text-muted">Update job requisition details.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small border-0 bg-danger bg-opacity-10 text-danger mb-4">@ViewBag.Error</div>
                    }

                    <form method="post" action="/Requisition/Edit">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Title</label>
                            <input name="Title" value="@Model.Title" class="form-control form-control-lg bg-light" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Description</label>
                            <textarea name="Description" class="form-control bg-light" rows="3">@Model.Description</textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Required Skills</label>
                            <input name="RequiredSkills" value="@Model.RequiredSkills" class="form-control form-control-lg bg-light" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-medium text-muted small text-uppercase">Experience Required (yrs)</label>
                                <input name="ExperienceRequired" type="number" value="@Model.ExperienceRequired" class="form-control form-control-lg bg-light" />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-medium text-muted small text-uppercase">Priority</label>
                                <select name="Priority" class="form-select form-select-lg bg-light">
                                    @if (Model.Priority == "Low") { <option value="Low" selected>Low</option> } else { <option value="Low">Low</option> }
                                    @if (Model.Priority == "Medium") { <option value="Medium" selected>Medium</option> } else { <option value="Medium">Medium</option> }
                                    @if (Model.Priority == "High") { <option value="High" selected>High</option> } else { <option value="High">High</option> }
                                </select>
                            </div>
                        </div>
                        <div class="mb-5">
                            <label class="form-label fw-medium text-muted small text-uppercase">Status</label>
                            <select name="Status" class="form-select form-select-lg bg-light">
                                @if (Model.Status == "Open") { <option value="Open" selected>Open</option> } else { <option value="Open">Open</option> }
                                @if (Model.Status == "Closed") { <option value="Closed" selected>Closed</option> } else { <option value="Closed">Closed</option> }
                            </select>
                        </div>
                        
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 w-100">Update Requisition</button>
                            <a href="/Requisition/Index" class="btn btn-light btn-lg text-muted fw-medium px-4 w-100">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>