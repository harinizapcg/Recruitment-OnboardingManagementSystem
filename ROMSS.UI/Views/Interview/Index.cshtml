@model List<ROMSS.UI.Models.DTO.InterviewDto>
@{
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Interviews for Application #@ViewBag.ApplicationId</h2>
            <p class="text-muted small mb-0">Manage interview schedules and feedback.</p>
        </div>
        <a href="/Interview/Schedule?applicationId=@ViewBag.ApplicationId&jobId=@ViewBag.JobId" class="btn btn-primary fw-medium px-4 shadow-sm">+ Schedule Interview</a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-calendar2-event text-muted opacity-50" viewBox="0 0 16 16">
                      <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                      <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM2 2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H2z"/>
                      <path d="M2.5 4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H3a.5.5 0 0 1-.5-.5V4z"/>
                    </svg>
                    <p class="mt-3 mb-0">No interviews scheduled yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 text-muted small text-uppercase">ID</th>
                                <th class="text-muted small text-uppercase">Date</th>
                                <th class="text-muted small text-uppercase">Interviewer</th>
                                <th class="text-muted small text-uppercase">Status</th>
                                <th class="pe-4 text-end text-muted small text-uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">@i.Id</td>
                                    <td class="fw-medium text-dark">@i.InterviewDate.ToShortDateString()</td>
                                    <td class="text-muted small">@i.Interviewer</td>
                                    <td>
                                        <span class="badge 
                                            @(i.Status == "Completed" ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25") fw-normal">
                                            @i.Status
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="/Interview/SubmitFeedback?applicationId=@ViewBag.ApplicationId&interviewId=@i.Id&jobId=@ViewBag.JobId" class="btn btn-sm btn-outline-primary py-1 px-2">Submit Feedback</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <div class="card-footer bg-white border-top text-center py-3">
                    <a href="/Interview/Feedback?applicationId=@ViewBag.ApplicationId&jobId=@ViewBag.JobId" class="btn btn-sm btn-light text-primary fw-medium px-4">View All Feedback</a>
                </div>
            }
        </div>
    </div>
    
    <div class="mt-4">
        <a href="/JobApplication/Index?jobId=@ViewBag.JobId" class="btn btn-light text-muted fw-medium px-4 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2 mb-1" viewBox="0 0 16 16">
              <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
            </svg>
            Back to Applications
        </a>
    </div>
</div>