@model List<ROMSS.UI.Models.DTO.InterviewFeedbackDto>
@{
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Feedback for Application #@ViewBag.ApplicationId</h2>
            <p class="text-muted small mb-0">Review interviewer feedback and ratings.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-chat-square-text text-muted opacity-50" viewBox="0 0 16 16">
                      <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2.5a2 2 0 0 0-1.6.8L8 14.333 6.1 11.8a2 2 0 0 0-1.6-.8H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2.5a1 1 0 0 1 .8.4l1.9 2.533a1 1 0 0 0 1.6 0l1.9-2.533a1 1 0 0 1 .8-.4H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                      <path d="M3 3.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zM3 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 6zm0 2.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                    <p class="mt-3 mb-0">No feedback submitted yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 text-muted small text-uppercase">Interview ID</th>
                                <th class="text-muted small text-uppercase">Interviewer ID</th>
                                <th class="text-muted small text-uppercase">Rating</th>
                                <th class="text-muted small text-uppercase">Result</th>
                                <th class="text-muted small text-uppercase">Comments</th>
                                <th class="text-muted small text-uppercase">Submitted At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">@f.InterviewId</td>
                                    <td class="text-muted small">@f.InterviewerId</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="fw-bold me-1">@f.Rating</span>
                                            <span class="text-muted small">/ 5</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(f.Result == "Selected" ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25") fw-normal">
                                            @f.Result
                                        </span>
                                    </td>
                                    <td class="small text-muted" style="max-width: 250px;">@f.Comments</td>
                                    <td class="small">@f.SubmittedAt.ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    
    <div class="mt-4">
        <a href="/Interview/Index?applicationId=@ViewBag.ApplicationId&jobId=@ViewBag.JobId" class="btn btn-light text-muted fw-medium px-4 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2 mb-1" viewBox="0 0 16 16">
              <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
            </svg>
            Back to Interviews
        </a>
    </div>
</div>