@model List<ROMSS.UI.Models.DTO.InterviewFeedbackDto>
@{
    Layout = "_Layout";
}

<div class="card shadow-lg p-4">
    <h2 class="fw-bold mb-4">Feedback for Application #@ViewBag.ApplicationId</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No feedback submitted yet.</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Interview ID</th>
                    <th>Interviewer ID</th>
                    <th>Rating</th>
                    <th>Comments</th>
                    <th>Submitted At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.InterviewId</td>
                        <td>@f.InterviewerId</td>
                        <td>@f.Rating / 5</td>
                        <td>@f.Comments</td>
                        <td>@f.SubmittedAt.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <a href="/Interview/Index?applicationId=@ViewBag.ApplicationId" class="btn btn-secondary mt-2">Back</a>
</div>