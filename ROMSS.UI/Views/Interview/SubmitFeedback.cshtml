@{
    Layout = "_Layout";
}

<div class="card shadow-lg p-4 mx-auto" style="max-width:500px">
    <h2 class="fw-bold mb-4">Submit Interview Feedback</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" action="/Interview/SubmitFeedback?jobId=@ViewBag.JobId">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ApplicationId" value="@ViewBag.ApplicationId" />
        <input type="hidden" name="InterviewId" value="@ViewBag.InterviewId" />
        <div class="mb-3">
            <label class="form-label">Interviewer ID</label>
            <input name="InterviewerId" type="number" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Rating (1-5)</label>
            <input name="Rating" type="number" min="1" max="5" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Comments</label>
            <textarea name="Comments" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Result</label>
            <div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="Result" value="Selected" required />
                    <label class="form-check-label text-success fw-bold">Selected</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="Result" value="Rejected" />
                    <label class="form-check-label text-danger fw-bold">Rejected</label>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-success w-100">Submit Feedback</button>
        <a href="/Interview/Index?applicationId=@ViewBag.ApplicationId&jobId=@ViewBag.JobId"
           class="btn btn-secondary w-100 mt-2">Cancel</a>
    </form>
</div>