@model ROMSS.UI.Models.DTO.AddJobRequestDto
@{
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white border-bottom py-4 px-4 px-md-5">
                    <h3 class="mb-0 fw-bold">Add Job</h3>
                    <p class="mb-0 small text-muted">Create a new job posting.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Requisition ID</label>
                            <input asp-for="RequisitionId" type="number" class="form-control form-control-lg bg-light" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Title</label>
                            <input asp-for="Title" class="form-control form-control-lg bg-light" placeholder="e.g. Senior Developer" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Description</label>
                            <textarea asp-for="Description" class="form-control bg-light" rows="3" placeholder="Job description"></textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Required Skills</label>
                            <input asp-for="RequiredSkills" class="form-control form-control-lg bg-light" placeholder="e.g. C#, SQL, Azure" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-medium text-muted small text-uppercase">Experience (yrs)</label>
                                <input asp-for="ExperienceRequired" type="number" class="form-control form-control-lg bg-light" />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-medium text-muted small text-uppercase">Location</label>
                                <input asp-for="Location" class="form-control form-control-lg bg-light" placeholder="e.g. Hyderabad" />
                            </div>
                        </div>
                        <div class="mb-5">
                            <label class="form-label fw-medium text-muted small text-uppercase">Status</label>
                            <select asp-for="Status" class="form-select form-select-lg bg-light">
                                <option value="Active">Active</option>
                                <option value="Closed">Closed</option>
                                <option value="On Hold">On Hold</option>
                            </select>
                        </div>
                        
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5">Save</button>
                            <a href="/Job/Index" class="btn btn-light btn-lg text-muted fw-medium px-4">Cancel</a>
                        </div>
                    </form>
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-4 small border-0 bg-danger bg-opacity-10 text-danger">@ViewBag.Error</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>