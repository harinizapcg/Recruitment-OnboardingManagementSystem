@model List<ROMSS.UI.Models.DTO.JobDto>
@{
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Jobs</h2>
            <p class="text-muted small mb-0">Manage job postings and applications.</p>
        </div>
        <a href="/Job/Add" class="btn btn-primary fw-medium px-4 shadow-sm">+ Add Job</a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-briefcase text-muted opacity-50" viewBox="0 0 16 16">
                      <path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v1.384l7.614 2.03a1.5 1.5 0 0 0 .772 0L16 5.884V4.5A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5z"/>
                      <path d="M0 12.5A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5V6.85L8.129 8.947a.5.5 0 0 1-.258 0L0 6.85v5.65z"/>
                    </svg>
                    <p class="mt-3 mb-0">No jobs found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 text-muted small text-uppercase">#</th>
                                <th class="text-muted small text-uppercase">Title</th>
                                <th class="text-muted small text-uppercase">Description</th>
                                <th class="text-muted small text-uppercase">Skills</th>
                                <th class="text-muted small text-uppercase">Exp</th>
                                <th class="text-muted small text-uppercase">Location</th>
                                <th class="text-muted small text-uppercase">Status</th>
                                <th class="pe-4 text-end text-muted small text-uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">@j.Id</td>
                                    <td class="fw-medium text-dark">@j.Title</td>
                                    <td class="text-muted small text-truncate" style="max-width: 150px;">@j.Description</td>
                                    <td><span class="badge bg-light text-dark border fw-normal">@j.RequiredSkills</span></td>
                                    <td class="small">@j.ExperienceRequired yrs</td>
                                    <td class="small">@j.Location</td>
                                    <td>
                                        <span class="badge @(j.Status == "Active" ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25")">
                                            @j.Status
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="/Job/Edit/@j.Id" class="btn btn-sm btn-outline-primary py-1 px-2 me-1">Edit</a>
                                        <form method="post" action="/Job/Delete/@j.Id" style="display:inline" onsubmit="return confirm('Delete this job?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2 me-1">Delete</button>
                                        </form>
                                        <a href="/JobApplication/Index?jobId=@j.Id" class="btn btn-sm btn-light text-primary border py-1 px-2">Apps</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>