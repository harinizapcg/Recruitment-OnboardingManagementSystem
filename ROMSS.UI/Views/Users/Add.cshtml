@model ROMSS.UI.Models.DTO.AddUserRequestDto
@{
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white border-bottom py-4 px-4 px-md-5">
                    <h3 class="mb-0 fw-bold">Add User</h3>
                    <p class="mb-0 small text-muted">Create a new system user.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-lg bg-light" placeholder="e.g. Ravi Kumar" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Email</label>
                            <input asp-for="Email" class="form-control form-control-lg bg-light" placeholder="email@example.com" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg bg-light" placeholder="e.g. 9876543210" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg bg-light" placeholder="••••••••" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Role</label>
                            <select asp-for="RoleId" class="form-select form-select-lg bg-light">
                                <option value="">-- Select Role --</option>
                                @foreach (var role in ViewBag.Roles as List<ROMSS.UI.Models.DTO.RoleDto>)
                                {
                                    <option value="@role.Id">@role.RoleName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-5 form-check form-switch mt-3">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" style="cursor: pointer;" />
                            <label class="form-check-label ms-2 mt-1" for="isActiveSwitch" style="cursor: pointer;">Active User Account</label>
                        </div>
                        
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5">Save</button>
                            <a href="/Users/Index" class="btn btn-light btn-lg text-muted fw-medium px-4">Cancel</a>
                        </div>
                    </form>
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-4 small border-0 bg-danger bg-opacity-10 text-danger">@ViewBag.Error</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>