@model ROMSS.UI.Models.DTO.RegisterDto

@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card border-0 shadow-lg" style="width: 450px; overflow: hidden;">
        <div class="card-header bg-primary text-white text-center py-4 border-0">
            <h3 class="mb-0 fw-bold">Create Account</h3>
            <p class="mb-0 small text-white-50">Join ROMSS today</p>
        </div>
        <div class="card-body p-4 p-md-5">
            <form method="post">
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-medium text-muted small text-uppercase">Full Name</label>
                    <input asp-for="Name" class="form-control form-control-lg bg-light" placeholder="John Doe" />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-medium text-muted small text-uppercase">Email Address</label>
                    <input asp-for="Email" class="form-control form-control-lg bg-light" placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-medium text-muted small text-uppercase">Password</label>
                    <input asp-for="Password" type="password" class="form-control form-control-lg bg-light" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="RoleId" class="form-label fw-medium text-muted small text-uppercase">Role</label>
                    <select asp-for="RoleId" class="form-select form-select-lg bg-light">
                        <option value="">-- Select Role --</option>
                        @foreach (var role in ViewBag.Roles)
                        {
                            <option value="@role.Id">@role.RoleName</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-grid gap-2 mt-5">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold">Register</button>
                </div>

                <div class="text-center mt-4">
                    <span class="text-muted small">Already have an account?</span>
                    <a href="/Auth/Login" class="text-decoration-none fw-semibold ms-1">Login here</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-4 text-center small border-0 bg-danger bg-opacity-10 text-danger" role="alert">
                    @ViewBag.Error
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}