@model RegisterRequestDto
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-center align-items-center" style="height:80vh;">
    <div class="card shadow p-4" style="width:400px;">

        <h3 class="text-center mb-3">Register</h3>

        <form method="post">

            <div class="mb-3">
                <input asp-for="Name" class="form-control" placeholder="Full Name" />
            </div>

            <div class="mb-3">
                <input asp-for="Email" class="form-control" placeholder="Email" />
            </div>

            <div class="mb-3">
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
            </div>

            <div class="mb-3">
                <input asp-for="RoleId" class="form-control" placeholder="Role Id (1 = Admin, 2 = HR)" />
            </div>

            <button class="btn btn-success w-100">Register</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <p class="text-danger mt-2 text-center">@ViewBag.Error</p>
        }

    </div>
</div>