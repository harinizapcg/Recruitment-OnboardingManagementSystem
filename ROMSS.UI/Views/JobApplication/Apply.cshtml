@using ROMSS.UI.Models.DTO
@{
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white border-bottom py-4 px-4 px-md-5">
                    <h3 class="mb-0 fw-bold">Apply for Job</h3>
                    <p class="mb-0 small text-muted">Submit an application for Job #@ViewBag.JobId.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small border-0 bg-danger bg-opacity-10 text-danger mb-4">@ViewBag.Error</div>
                    }

                    <form method="post" action="/JobApplication/Apply" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobId" value="@ViewBag.JobId" />

                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Candidate</label>
                            <select name="candidateId" class="form-select form-select-lg bg-light" required>
                                <option value="">-- Select Candidate --</option>
                                @if (ViewBag.Candidates != null)
                                {
                                    @foreach (var c in (List<CandidateDto>)ViewBag.Candidates)
                                    {
                                        <option value="@c.Id">@c.Name — @c.Email</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Resume <span class="text-danger">*</span></label>
                            <input name="resume" type="file" class="form-control form-control-lg bg-light" accept=".pdf,.doc,.docx" required />
                            <small class="text-muted mt-1 d-block">Accepted: PDF, DOC, DOCX</small>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-medium text-muted small text-uppercase">Cover Letter <span class="text-muted fw-normal text-lowercase">(optional)</span></label>
                            <input name="coverLetter" type="file" class="form-control form-control-lg bg-light" accept=".pdf,.doc,.docx" />
                            <small class="text-muted mt-1 d-block">Accepted: PDF, DOC, DOCX</small>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 w-100">Submit Application</button>
                            <a href="/JobApplication/Index?jobId=@ViewBag.JobId" class="btn btn-light btn-lg text-muted fw-medium px-4 w-100">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>