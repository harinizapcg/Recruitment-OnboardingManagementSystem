@model List<ROMSS.UI.Models.DTO.JobApplicationDto>
@{
    Layout = "_Layout";
}

<div class="card shadow-lg p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Applications for Job #@ViewBag.JobId</h2>
        <a href="/JobApplication/Apply?jobId=@ViewBag.JobId" class="btn btn-success px-4">+ Apply</a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No applications found.</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Candidate</th>
                    <th>Status</th>
                    <th>Applied At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.Id</td>
                        <td>
                            @a.CandidateName
                            <small class="text-muted">(ID: @a.CandidateId)</small>
                        </td>
                        <td>
                            <span class="badge
                                @(a.Status == "Shortlisted" ? "bg-success" :
                                                                    a.Status == "Rejected" ? "bg-danger" : "bg-secondary")">
                                @a.Status
                            </span>
                        </td>
                        <td>@a.AppliedAt.ToShortDateString()</td>
                        <td>
                            @if (a.Status == "Applied" || a.Status == "Pending")
                            {
                                <form method="post" action="/JobApplication/Shortlist/@a.Id"
                                      style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobId" value="@ViewBag.JobId" />
                                    <button type="submit" class="btn btn-sm btn-success">Shortlist</button>
                                </form>
                                <form method="post" action="/JobApplication/Reject/@a.Id"
                                      style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobId" value="@ViewBag.JobId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                </form>
                            }
                            else if (a.Status == "Shortlisted")
                            {
                                <a href="/Interview/Index?applicationId=@a.Id&jobId=@ViewBag.JobId"
                                   class="btn btn-sm btn-info">Interviews</a>
                            }
                            else if (a.Status == "Rejected")
                            {
                                <span class="text-muted fst-italic">No further action</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>