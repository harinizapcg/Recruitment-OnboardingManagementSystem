@model List<ROMSS.UI.Models.DTO.JobApplicationDto>
@{
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger small border-0 bg-danger bg-opacity-10 text-danger mb-4">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Applications for Job #@ViewBag.JobId</h2>
            <p class="text-muted small mb-0">Review and manage candidates applying for this position.</p>
        </div>
        <a href="/JobApplication/Apply?jobId=@ViewBag.JobId" class="btn btn-primary fw-medium px-4 shadow-sm">+ Apply</a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger small border-0 bg-danger bg-opacity-10 text-danger mb-4">@ViewBag.Error</div>
    }

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-file-earmark-person text-muted opacity-50" viewBox="0 0 16 16">
                      <path d="M11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                      <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2v9.255S12 12 8 12s-5 1.755-5 1.755V2a1 1 0 0 1 1-1h5.5v2z"/>
                    </svg>
                    <p class="mt-3 mb-0">No applications found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 text-muted small text-uppercase">ID</th>
                                <th class="text-muted small text-uppercase">Candidate</th>
                                <th class="text-muted small text-uppercase">Status</th>
                                <th class="text-muted small text-uppercase">Applied At</th>
                                <th class="pe-4 text-end text-muted small text-uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">@a.Id</td>
                                    <td>
                                        <div class="fw-medium text-dark">@a.CandidateName</div>
                                        <div class="text-muted small">ID: @a.CandidateId</div>
                                    </td>
                                    <td>
                                        <span class="badge 
                                            @(a.Status == "Shortlisted" ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : 
                                              a.Status == "Rejected" ? "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" : "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25") fw-normal">
                                            @a.Status
                                        </span>
                                    </td>
                                    <td class="small">@a.AppliedAt.ToShortDateString()</td>
                                    <td class="pe-4 text-end">
                                        @if (a.Status == "Applied" || a.Status == "Pending")
                                        {
                                            <form method="post" action="/JobApplication/Shortlist/@a.Id" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="jobId" value="@ViewBag.JobId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2 me-1">Shortlist</button>
                                            </form>
                                            <form method="post" action="/JobApplication/Reject/@a.Id" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="jobId" value="@ViewBag.JobId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2">Reject</button>
                                            </form>
                                        }
                                        else if (a.Status == "Shortlisted")
                                        {
                                            <a href="/Interview/Index?applicationId=@a.Id&jobId=@ViewBag.JobId" class="btn btn-sm btn-outline-info py-1 px-2">Interviews</a>
                                        }
                                        else if (a.Status == "Rejected")
                                        {
                                            <span class="text-muted small fst-italic">No further action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>