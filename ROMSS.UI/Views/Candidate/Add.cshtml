@model ROMSS.UI.Models.DTO.AddCandidateRequestDto
@{
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white border-bottom py-4 px-4 px-md-5">
                    <h3 class="mb-0 fw-bold">Add Candidate</h3>
                    <p class="mb-0 small text-muted">Enter the details for the new candidate.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Name</label>
                            <input asp-for="Name" class="form-control form-control-lg bg-light" placeholder="Full name" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Email</label>
                            <input asp-for="Email" class="form-control form-control-lg bg-light" placeholder="email@example.com" />
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Phone</label>
                            <input asp-for="Phone" class="form-control form-control-lg bg-light" placeholder="Phone number" />
                            <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Skills</label>
                            <input asp-for="Skills" class="form-control form-control-lg bg-light" placeholder="e.g. C#, SQL, React" />
                            <span asp-validation-for="Skills" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-medium text-muted small text-uppercase">Experience (yrs)</label>
                                <input asp-for="Experience" type="number" class="form-control form-control-lg bg-light" />
                                <span asp-validation-for="Experience" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-medium text-muted small text-uppercase">Source</label>
                                <input asp-for="Source" class="form-control form-control-lg bg-light" placeholder="e.g. LinkedIn" />
                                <span asp-validation-for="Source" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="mb-5">
                            <label class="form-label fw-medium text-muted small text-uppercase">Upload Resume</label>
                            <input asp-for="ResumePath" type="file" class="form-control form-control-lg bg-light" accept=".pdf,.doc,.docx" />
                            <span asp-validation-for="ResumePath" class="text-danger small mt-1 d-block"></span>
                        </div>
                        
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5">Save</button>
                            <a href="/Candidate/Index" class="btn btn-light btn-lg text-muted fw-medium px-4">Cancel</a>
                        </div>
                    </form>
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-4 small border-0 bg-danger bg-opacity-10 text-danger">@ViewBag.Error</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}