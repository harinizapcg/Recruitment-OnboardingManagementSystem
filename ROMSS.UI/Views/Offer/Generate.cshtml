@{
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white border-bottom py-4 px-4 px-md-5">
                    <h3 class="mb-0 fw-bold">Generate Offer</h3>
                    <p class="mb-0 small text-muted">Create an offer for Application #@ViewBag.ApplicationId.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small border-0 bg-danger bg-opacity-10 text-danger mb-4">@ViewBag.Error</div>
                    }

                    <form method="post" action="/Offer/Generate">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ApplicationId" value="@ViewBag.ApplicationId" />
                        
                        <div class="mb-4">
                            <label class="form-label fw-medium text-muted small text-uppercase">Salary</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-end-0 text-muted">$</span>
                                <input name="Salary" type="number" step="0.01" class="form-control bg-light border-start-0" required placeholder="0.00" />
                            </div>
                        </div>
                        
                        <div class="mb-5">
                            <label class="form-label fw-medium text-muted small text-uppercase">Joining Date</label>
                            <input name="JoiningDate" type="date" class="form-control form-control-lg bg-light" required />
                        </div>
                        
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Generate Offer</button>
                            <a href="/Offer/Index?applicationId=@ViewBag.ApplicationId" class="btn btn-light btn-lg text-muted fw-medium">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>