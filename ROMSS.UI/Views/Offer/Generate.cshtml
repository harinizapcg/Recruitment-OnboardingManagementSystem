@{
    Layout = "_Layout";
}

<div class="card shadow-lg p-4 mx-auto" style="max-width:500px">
    <h2 class="fw-bold mb-4">Generate Offer</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" action="/Offer/Generate">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ApplicationId" value="@ViewBag.ApplicationId" />
        <div class="mb-3">
            <label class="form-label">Salary</label>
            <input name="Salary" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Joining Date</label>
            <input name="JoiningDate" type="date" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success w-100">Generate</button>
    </form>
</div>