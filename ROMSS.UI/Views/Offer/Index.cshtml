@model ROMSS.UI.Models.DTO.OfferDto
@{
    Layout = "_Layout";
}

<div class="card shadow-lg p-4 mx-auto" style="max-width:600px">
    <h2 class="fw-bold mb-4">Offer for Application #@ViewBag.ApplicationId</h2>

    @if (Model == null)
    {
        <div class="alert alert-info">No offer generated yet.</div>
        <a href="/Offer/Generate?applicationId=@ViewBag.ApplicationId"
           class="btn btn-success">Generate Offer</a>
    }
    else
    {
        <table class="table">
            <tr><th>Salary</th><td>@Model.Salary.ToString("C")</td></tr>
            <tr><th>Joining Date</th><td>@Model.JoiningDate.ToShortDateString()</td></tr>
            <tr><th>Status</th><td><span class="badge bg-info">@Model.Status</span></td></tr>
            <tr><th>Created At</th><td>@Model.CreatedAt.ToShortDateString()</td></tr>
        </table>

        <a href="/Onboarding/Index?applicationId=@ViewBag.ApplicationId"
           class="btn btn-primary mt-3">Proceed to Onboarding →</a>
    }
</div>