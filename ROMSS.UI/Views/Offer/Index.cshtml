@model ROMSS.UI.Models.DTO.OfferDto
@{
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white border-bottom py-4 px-4 px-md-5">
                    <h3 class="mb-0 fw-bold">Offer Details</h3>
                    <p class="mb-0 small text-muted">Application #@ViewBag.ApplicationId</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (Model == null)
                    {
                        <div class="text-center py-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-envelope-paper text-muted opacity-50 mb-3" viewBox="0 0 16 16">
                              <path d="M4 0a2 2 0 0 0-2 2v1.133l-.941.502A2 2 0 0 0 0 5.4V14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V5.4a2 2 0 0 0-1.059-1.765L14 3.133V2a2 2 0 0 0-2-2H4Zm10 4.267.47.25A1 1 0 0 1 15 5.4v.817l-1 .6v-2.55Zm-1 3.15-3.75 2.25L8 8.917l-1.25.75L3 7.417V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v5.417Zm-11-.6-1-.6V5.4a1 1 0 0 1 .53-.882L2 4.267v2.55Zm13 .766v5.734a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V7.583l4.581 2.748L8 11.751l2.419-1.42L15 7.583Z"/>
                            </svg>
                            <h5 class="fw-bold mb-2">No Offer Generated</h5>
                            <p class="text-muted small mb-4">An offer has not been generated for this candidate yet.</p>
                            <a href="/Offer/Generate?applicationId=@ViewBag.ApplicationId" class="btn btn-primary btn-lg fw-bold px-4">Generate Offer</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-borderless align-middle mb-0">
                                <tbody>
                                    <tr class="border-bottom">
                                        <th class="py-3 text-muted small text-uppercase w-50">Salary</th>
                                        <td class="py-3 fw-bold text-dark fs-5">@Model.Salary.ToString("C")</td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <th class="py-3 text-muted small text-uppercase">Joining Date</th>
                                        <td class="py-3 fw-medium">@Model.JoiningDate.ToShortDateString()</td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <th class="py-3 text-muted small text-uppercase">Status</th>
                                        <td class="py-3">
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 py-2 px-3 fw-normal">
                                                @Model.Status
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="py-3 text-muted small text-uppercase">Created At</th>
                                        <td class="py-3 small">@Model.CreatedAt.ToShortDateString()</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-grid mt-2">
                            <a href="/Onboarding/Index?applicationId=@ViewBag.ApplicationId" class="btn btn-primary btn-lg fw-bold">Proceed to Onboarding →</a>
                        </div>
                    }
                </div>
            </div>
            
            <div class="mt-4 text-center">
                <a href="/JobApplication/Index" class="btn btn-light text-muted fw-medium px-4 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2 mb-1" viewBox="0 0 16 16">
                      <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                    </svg>
                    Back to Applications
                </a>
            </div>
        </div>
    </div>
</div>